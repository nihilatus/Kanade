#pragma once

// Copy this file to include/secrets.h and set your own password.
// include/secrets.h is listed in .gitignore. Do not commit a real password.
// The access point stays off if the password is still the placeholder below,
// or if it is shorter than 8 characters.

#define WIFI_AP_SSID "JIS-Chord"
#define WIFI_AP_PASSWORD "replace-with-8-or-more-chars"

// Optional. Leave empty and the config API stays open on the access point.
// When this is a non-empty string, /api/* requires the header X-Api-Token.
// The phone page asks for the value; it is not printed on the serial console.
#define WIFI_API_TOKEN ""
